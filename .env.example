# Copy this file to .env and fill in real values. .env is gitignored;
# .env.example documents the variable names with safe placeholders and is
# committed (loaded as a fallback so the project still boots without a .env).

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=*
SITE_URL=http://127.0.0.1:8000

# ── ZainPay ────────────────────────────────────────────────────────────────
# Create a merchant account + zainbox at https://zainpay.ng specifically for
# Glittering Field Academy — do not reuse another project's zainbox/keys.
# JWT from the ZainPay merchant dashboard (Bearer token for API calls).
ZAINPAY_PUBLIC_KEY=
ZAINPAY_ZAINBOX_CODE=
# Sandbox: https://sandbox.zainpay.ng  |  Live: https://api.zainpay.ng
ZAINPAY_BASE_URL=https://sandbox.zainpay.ng
ZAINPAY_CALLBACK_URL=http://127.0.0.1:8000/payments/zainpay/callback/
# Verifies the Zainpay-Signature HMAC-SHA256 header on incoming webhooks.
ZAINPAY_SECRET_KEY=
# Lookback window (hours) for the reconcile_zainpay management command.
ZAINPAY_RECONCILE_LOOKBACK_HOURS=720

# ── Email (Gmail SMTP, same shape as the giia project) ──────────────────────
# EMAIL_HOST_USER is the Gmail address; EMAIL_HOST_PASSWORD is a Gmail App
# Password (Google Account → Security → App passwords), never the real
# account password. DEFAULT_FROM_EMAIL falls back to EMAIL_HOST_USER if unset.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
